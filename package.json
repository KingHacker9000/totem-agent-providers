    "check": "npm run typecheck && npm test && npm run distribution:reproducibility"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
